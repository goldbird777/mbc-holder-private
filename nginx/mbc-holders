server {
    server_name mbc-holders.duckdns.org microbitcoin.co.kr www.microbitcoin.co.kr;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # HTML은 캐시하지 않음 (변경 사항 즉시 반영)
    location ~* \.(html|htm)$ {
        root /var/www/html;
        add_header Cache-Control "public, max-age=300, must-revalidate" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Expires "0" always;
    }

    # 정적 자산(이미지, CSS, JS)은 짧게 캐시
    # /assets/* (분리한 app.css/app.js) — 캐시 1년, 파일명 ?v=N으로 무효화
    location ^~ /assets/ {
        root /var/www/html;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    location ~* \.(jpg|jpeg|png|gif|svg|webp|ico|woff2?)$ {
        root /var/www/html;
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
    }

    # SPA fallback
    location / {
        root /var/www/html;
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "public, max-age=300, must-revalidate" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    location /api/ {
        proxy_pass http://localhost:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # 업로드 디렉토리 (token 아이콘 등) - ubuntu가 쓰기 가능
    location ^~ /uploads/ {
        alias /var/www/uploads/;
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
    }

    location = /robots.txt { root /var/www/html; access_log off; }
    location = /sitemap.xml { root /var/www/html; access_log off; }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/microbitcoin.co.kr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/microbitcoin.co.kr/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    server_name mbc-holders.duckdns.org microbitcoin.co.kr www.microbitcoin.co.kr;
    return 301 https://$host$request_uri;
}
